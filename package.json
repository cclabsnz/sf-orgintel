{
  "name": "@cclabsnz/sf-orgintel",
  "version": "0.1.0",
  "description": "Understand how a Salesforce org actually works — its processes, people, and couplings — from metadata and behavioral data, entirely locally.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --passWithNoTests",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js test/unit --passWithNoTests",
    "prepack": "npm run build",
    "clean": "rm -rf lib",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "dependencies": {
    "@cclabsnz/sf-core": "^0.3.0",
    "@oclif/core": "^4",
    "@salesforce/core": "^9",
    "@salesforce/sf-plugins-core": "^13"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29",
    "ajv": "^8",
    "@types/node": "^22",
    "jest": "^29",
    "ts-jest": "^29",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cclabsnz/sf-orgintel.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "oclif": {
    "bin": "sf",
    "dirname": "sf",
    "commands": "./lib/commands",
    "pluginType": "jit",
    "flexibleTaxonomy": true,
    "devPlugins": [],
    "topics": {
      "intel": {
        "description": "Understand how a Salesforce org actually works — capabilities, domains, and cross-object couplings, computed locally."
      }
    }
  },
  "files": [
    "/lib",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "PERMISSIONS.md",
    "!/lib/**/*.map"
  ],
  "homepage": "https://github.com/cclabsnz/sf-orgintel#readme",
  "bugs": {
    "url": "https://github.com/cclabsnz/sf-orgintel/issues"
  },
  "keywords": [
    "salesforce",
    "sf-plugin",
    "sfdx",
    "org-intelligence",
    "coupling",
    "flow",
    "apex",
    "architecture"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "pnpm": {
    "overrides": {
      "form-data": "^4.0.6",
      "js-yaml@3": "^3.15.1",
      "handlebars": "^4.7.9",
      "brace-expansion": "^5.0.9",
      "fast-uri@3": "^3.1.5"
    }
  }
}
