node_modules/
# Build output only — anchored so it never swallows a source dir named lib/
# (e.g. src/lib). An unanchored rule here silently excluded wire.ts and cache.ts once
# already; the package then built locally from untracked files and failed in CI.
/lib/
/lib-test/
*.js.map
*.tsbuildinfo
.DS_Store
coverage/
package-lock.json
npm-debug.log*
pnpm-debug.log*

# Salesforce CLI local state
.sfdx/
.sf/

# Report artefacts written during development. coupling-graph.json,
# landscape-manifest.json and anatomy.json were retired in 1.0.0 and are no longer
# written by anything, so they are no longer listed here.
orgintel-*.html
orgintel-*.json
graph-fragment.json
anatomy-fragment.json

# Internal docs — kept locally, never published
CLAUDE.md
DESIGN_BRIEF.md
/docs/superpowers/
